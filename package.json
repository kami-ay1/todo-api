{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/app.ts",
    "build": "prisma generate && tsc --project tsconfig.build.json",
    "start": "node dist/app.js",
    "local": "tsx deploy/local.ts",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:baseline": "prisma migrate diff --from-config-datasource --to-schema \"prisma/schema.prisma\" --exit-code && prisma migrate resolve --applied 0_init"
  },
  "keywords": [],
  "author": "",
